# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — nigdy go nie commituj.

# --- LLM ---------------------------------------------------------------
# mock      = deterministyczny model offline (bez kosztów, bez klucza) — domyślny
# anthropic = prawdziwy Claude przez Anthropic Python SDK
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model główny (claude-sonnet-5-5 domyślnie, claude-opus-5-5 dla trudniejszych artykułów)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model kwarantanny (streszcza nieufne źródła; bez narzędzi). Pusty = ten sam co główny.
ANTHROPIC_QUARANTINE_MODEL=
# Poziom wysiłku: low|medium|high|xhigh|max
ANTHROPIC_EFFORT=medium
# Serwerowy fallback przy odmowie modelu: default|off
ANTHROPIC_FALLBACKS=default

# --- Baza danych -------------------------------------------------------
DATABASE_URL=sqlite:///./data/kurier.db
# Docker: postgresql+psycopg://kurier:kurier@db:5432/kurier

# --- Orkiestrator ------------------------------------------------------
# Limity na jeden artykuł
AGENT_MAX_CLAIMS=12
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_COST_USD=1.50
# Transport do sandboksa: stdio (proces potomny) | http (osobny kontener)
WEB_SANDBOX_TRANSPORT=stdio
WEB_SANDBOX_URL=http://mcp-web-sandbox:8765/mcp

# --- Sandbox (strefa nieufna) ------------------------------------------
# 1 = publiczne API odpowiadają z fixture'ów (offline, deterministycznie)
SANDBOX_OFFLINE=1
SANDBOX_TIMEOUT_S=10
SANDBOX_MAX_BYTES=2097152
SANDBOX_MAX_TEXT_CHARS=20000
# Wyłącznie do testów red-team: lista host:port, które wolno pobierać mimo blokady
# adresów prywatnych. Pusta w produkcji!
SANDBOX_TEST_ALLOW=

# --- Red-team ----------------------------------------------------------
REDTEAM_PORT=8899

# --- Frontend ----------------------------------------------------------
VITE_API_URL=http://localhost:8000
